{
  "name": "argonath",
  "version": "0.1.1-alpha.0",
  "private": true,
  "scripts": {
    "release": "commit-and-tag-version --prerelease alpha",
    "release:patch": "commit-and-tag-version --release-as patch --prerelease alpha",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:stable": "commit-and-tag-version --release-as $(node -p \"require('./package.json').version.replace(/-alpha.*/, '')\")"
  },
  "devDependencies": {
    "commit-and-tag-version": "^12.5.0"
  }
}
