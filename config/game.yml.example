# Argonath Game Server Configuration
# Copy this file to game.yml and customize for your server.

game:
  name: "My Game Server"
  steam_app_id: ""                    # Steam app ID for the dedicated server
  process_name: ""                    # Executable name to detect (e.g. "valheim_server.x86_64")
  launch_script: "/game/start.sh"    # Path to launch script (preferred)
  # launch_exe: "/game/server"       # Direct executable (fallback if no script)
  server_dir: "/game"
  log_file: ""                        # Path to the game's log file
  max_players: 8
  args: []                            # Additional launch arguments

server:
  port: 5000
  host: "0.0.0.0"

auth:
  mode: "local"   # "local" (username/password), "none" (no auth, trusted network)

steamcmd:
  enabled: true
  install_dir: "/game"
  validate: true   # Verify files on update

compatibility:
  wine: false
  proton_version: ""   # e.g. "GE-Proton10-32"
